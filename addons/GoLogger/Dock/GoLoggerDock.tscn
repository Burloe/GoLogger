size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "There are four hotkeys available to interact with GoLogger during runtime. 
[b]Start Session[/b][/color][color=#d4d4d4]:[/color]           [color=#6a9955]Ctrl[/color] + [color=#6a9955]Shift[/color] + [color=#dcdcaa]O[/color]
[b]Stop Session[/b][/color][color=#d4d4d4]:[/color]            [color=#6a9955]Ctrl[/color] + [color=#6a9955]Shift[/color] + [color=#dcdcaa]P[/color]
[b]Display Instance ID[/b][/color][color=#d4d4d4]:[/color]  [color=#6a9955]Ctrl[/color] + [color=#6a9955]Shift[/color] + [color=#dcdcaa]I[/color]
Hotkeys can be changed using InputEventShortcut resources. As such, they're excluded and doesn't crowd your InputMap. You can easily add, change or remove bindings to the resources in the Settings tab which opens the resources in the Inspector."
fit_content = true

