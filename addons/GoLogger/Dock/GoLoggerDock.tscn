[node name="RichTextLabel" type="RichTextLabel" parent="Help/Methods&Hotkeys/VBoxContainer/Instances/MarginContainer" unique_id=717151763]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "[font_size=14]There are times that running multiple instances at the same time while debugging/testing your project. Such is the case for multiplayer games. However, when doing so. You have two instances logging into one log file and you need some way to know which instance logged which entry. This is possible by adding the {instance_id} tag to the Entry Format setting. An instance ID is a simple ID string that is generated at runtime(much like UIDs). 

Use the [b]Display Instance ID[/b] hotkey to see display the ID of an instance in the top left corner of your viewport."
fit_content = true

