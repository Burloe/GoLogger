[node name="Label" type="Label" parent="Help/MoreInfo/MarginContainer/HBoxContainer/VBoxContainer/HBoxContainer2" unique_id=27916166]
layout_mode = 2
size_flags_horizontal = 3
text = "If issues with the plugin arise, start by deleting the \"gologger_data.ini\" and run your 
project once to generate a fresh one(will reset settings and categories).

Note that autoloaded scripts/scenes are loaded in the order as shown in ProjectSettings > Globals > Autoload. 
If an autoload is trying to log an entry before Log.tscn is loaded, it might throw an error or simply not log the entry.
Please move Log.tscn higher in the list in that case.

If issues persists afterwards, please open an issue on Github with the link below."

