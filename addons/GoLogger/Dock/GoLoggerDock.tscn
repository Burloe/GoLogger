[node name="RichTextLabel" type="RichTextLabel" parent="Help/GettingStarted/VBoxContainer/Concurrencies/MarginContainer" unique_id=1890232147]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "When running multiple instances of your project, prevalent in cases with mutliplayer games. The two or more instances will log into the same file, and by default. Entries are tagged with a unique instance ID to help distinguish which instances logged an entry. The instance ID can be removed by erasing the {instance_id} tag from the [color=fc4674]Entry Format[/color] setting. In any instance, you can hit the [color=fc4674]Print Instance ID[/color] hotkey([i]Ctrl + Shift + I[/]) to print that instance's ID to output."
fit_content = true

