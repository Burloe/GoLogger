[node name="RichTextLabel" type="RichTextLabel" parent="HelpTab/GettingStarted/VBoxContainer/DirectoryHelp/MarginContainer" unique_id=1565100639]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "The default directory where your .log files are stored is \"user://gologger/\". Since this directory is outside of the \"res://\" (project folder), it isn't packaged with your project when you export it, meaning your users/players have access to the files and can share them with the developer. It is recommended that you use \"user://\" but change the \"gologger\" part. 

[color=lightred][b]Warning![/b][color=pink] Do [b]NOT[/b] use \"user://logs/\". Godot stores it's own logs in that folder and you risk that GoLogger might delete said logs in it's operations. There are safeguard to prevent this directory from being used but still, never use it. 

Remember that there are buttons to open the directory using or operating system's file browser. You can also use the normal Project > \"Open User Data Folder\" in Godot.

"
fit_content = true

