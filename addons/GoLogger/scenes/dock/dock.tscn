theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "Each category in the Category tab corresponds to a folder in the base directory. When a session starts, a .log file is created inside that folder, named with the date, timestamp, and category.

Additionally, you can mark one of your categories as 'Default'. Logging entries without specifying a category will log it to the marked default category. This is especially useful if you only use a single category to log and don't necessitates you to specify the category constantly."
fit_content = true

