size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "GoLogger works immediately with the default configuration and comes with a single \"game\" category. Meaning you can instantly start creating entries such as: 
    [i][color=#dcdcaa]Log[/color].[color=#6dc2ff]msg[/color]([color=#ce9178]\"This is my first log entry.\"[/color], [color=#ce9178]\"game\"[/color])[/i]
Use the Category tab to add, remove, or rename categories. 

GoLogger uses an [b]Log[/b] singleton, making its functions accessible from all scenes and scripts.

A session defines when logging is active. Sessions can be started or stopped at any time using hotkeys or through code.
By default, a session starts automatically when the project runs (this can be disabled in the Settings tab).
	"
fit_content = true

