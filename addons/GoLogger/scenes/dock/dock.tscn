[node name="RichTextLabel" type="RichTextLabel" parent="HelpTab/GettingStarted/VBoxContainer/LogBrowserHelp/MarginContainer" unique_id=1476901840]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "A new LogBrowser was added in 1.4 which allows you to see your .log files and read their contents, all within the editor. 

It detects files is by the file name and it's file type. Meaning the file has to begin with the category's name and end with \".log\" to be detected. The drawback with this is that it won't detect files that you've renamed. However, you can uncheck the setting \"Log Browser strict file name detection\"  under Settings tab > General. This will ignore the category name restriction, which will read all .log files.

Currently, the Log Browser will only detect and find files in active category's. It won't look for folders of past/deleted categories. A proper file browser may be implemented in a future update."
fit_content = true

