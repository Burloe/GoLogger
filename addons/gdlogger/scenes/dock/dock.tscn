foldable_group = SubResource("FoldableGroup_fx5fv")

[node name="RichTextLabel" type="RichTextLabel" parent="DockTabContainer/HelpTab/Methods/VBoxContainer/FormattingHelp" unique_id=838472294]
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/normal = SubResource("StyleBoxEmpty_2vjd2")
theme_override_styles/focus = SubResource("StyleBoxEmpty_2vjd2")
bbcode_enabled = true
text = "Log Header and Entries can be formatted in any way you may want in the Settings tab. You can add any string you want but you can also add tags to include useful data to said settings. Such as the project name, version, date and time. You can format the date and time for your preference/region.

Any tag and custom string formatting can be used.  

 [b]Log Header:[/b][color=darkgray]		{project_name} {version} {category} session [{yy}-{mm}-{dd} | {hh}:{mi}:{ss}]:    >    GDLogger v.1.4 game session [2025-12-20 | 18:42:21]:[/color]

 [b]Entry Format:[/b][color=darkgray]	[{hh}:{mi}:{ss}] {instance_id}:  {entry}    >    [09:32:16] b4jw0: Entry String[/color]

[b]Supported tags:[/b]
	{category} 									[color=darkgray][i]Only available for Log Header[/i][/color]
	{instance_id}								[color=darkgray][i]Only available for Entry Format[/i][/color]
	{entry} 										[color=darkgray][i]Only available for Entry Format and is required[/i][/color]
    {project_name}  {version} 		[color=darkgray][i]Project name & version fetched from ProjectSettings[/i][/color]
    {yy}  {mm}  {dd} 						[color=darkgray][i]Year, Month, Day[/i][/color]
    {hh}  {mi}  {ss} 							[color=darkgray][i]Hour, Minute, Second[/i][/color]
"
fit_content = true

