[node name="FunctionsHelp" type="FoldableContainer" parent="DockTabContainer/HelpTab/Methods/VBoxContainer" unique_id=347626334]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme = ExtResource("4_o07th")
